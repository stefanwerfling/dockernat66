# Copy to .env and adjust.

# Image (e.g. from your own registry: registry.example.com/docker-nat66) and tag.
# Default: local image docker-nat66, built from this repo if missing.
DOCKER_NAT66_IMAGE=docker-nat66
DOCKER_NAT66_TAG=latest

# docker = Docker gets IPv6 on every network and does NAT66 itself.
#          Containers reach the internet over IPv6; inbound via `ports:` in compose.
# nat66  = docker-nat66 does NAT66 + inbound firewall itself and can forward
#          WAN ports to containers (DOCKER_NAT66_FORWARDS).
DOCKER_NAT66_MODE=docker

# Interface with the public IPv6 (empty = auto: default route with a global address).
DOCKER_NAT66_WAN=eth1

# nat66 mode only: proto/port[-end]=container[:port] or =[ipv6][:port], space/comma separated
# DOCKER_NAT66_FORWARDS=tcp/443=web:443 udp/10000-10100=game
DOCKER_NAT66_FORWARDS=

# Write /etc/docker/daemon.json and restart Docker once when needed.
DOCKER_NAT66_SETUP_DOCKER=true

# Keep net.ipv6.conf.all.forwarding=1 and <wan>.accept_ra=2 (also persisted to /etc/sysctl.d).
DOCKER_NAT66_SYSCTL=true

# Re-check interval in seconds.
DOCKER_NAT66_INTERVAL=10

# info | debug (debug prints the nftables ruleset)
RUST_LOG=info
